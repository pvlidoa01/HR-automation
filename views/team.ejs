<%- include('partials/header') %>
<div class="page-head"><div><h1>My team</h1>
  <p class="muted">Your direct reports. Open a person to see who reports to them. You write the reviews of your direct reports; when one of your managers submits a review, you confirm it or adjust it before it is final. HR and the CEO can read every review. Employees see theirs only after HR releases the cycle, and never the HR action points.</p>
</div></div>
<% if (!groups.length) { %>
  <div class="card empty">You have no reviews to write.</div>
<% } %>
<% groups.forEach(g => { %>
  <h2><%= g.name %> <span class="badge cycle-<%= g.status %>"><%= { open: 'Open', released: 'Released' }[g.status] %></span>
    <% if (g.deadline && g.status === 'open') { %><span class="muted small">· due <%= fmtDate(g.deadline) %></span><% } %></h2>
  <div class="card org-tree">
    <% g.roots.forEach(node => { %>
      <%- include('partials/org-node', { node, mode: 'team', cycleOpen: g.status === 'open', isHrUser: false, STATUS_LABELS, csrfToken, user }) %>
    <% }) %>
  </div>
<% }) %>
<% if (earlier.length) { %>
  <h2>Earlier reviews of your team</h2>
  <p class="muted small">Reviews written by their previous managers. You can read them but not change them.</p>
  <div class="card">
    <ul>
      <% earlier.forEach(e => { %><li><a href="/reviews/<%= e.id %>"><%= e.employee_name %> · <%= e.cycle_name %></a></li><% }) %>
    </ul>
  </div>
<% } %>
<%- include('partials/footer') %>
