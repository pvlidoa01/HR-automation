<%- include('partials/header') %>
<%
  const list = (names) => names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
%>
<div class="page-head"><div><h1><%= asHome ? `Hello ${user.name.split(' ')[0]}` : 'My team' %></h1></div></div>

<% if (!groups.length) { %>
  <div class="card empty">You have no reviews to write.</div>
<% } %>

<% groups.forEach(g => {
     const isOpen = g.status === 'open';
     const toWrite = todo.toWrite.filter((t) => t.cycle_id === g.id).length;
     const toConfirm = todo.toConfirm.filter((t) => t.cycle_id === g.id).length; %>
  <h2><%= g.name %> <span class="badge cycle-<%= g.status %>"><%= { open: 'Open', released: 'Released' }[g.status] %></span>
    <% if (g.deadline && isOpen) { %><span class="muted small">· due <%= fmtDate(g.deadline) %></span><% } %></h2>

  <% if (isOpen) { %>
    <div class="team-howto">
      <p class="team-todo">
        <% if (toWrite || toConfirm) { %>
          <strong>To do:</strong>
          <%= [toWrite ? `${toWrite} review${toWrite === 1 ? '' : 's'} to write` : '', toConfirm ? `${toConfirm} to confirm` : ''].filter(Boolean).join(' · ') %>
        <% } else { %>
          <strong>Nothing to do right now.</strong> All your reviews are submitted.
        <% } %>
      </p>
      <ul class="small">
        <li>Write a review for each person who reports to you<%= g.deadline ? ` by ${fmtDate(g.deadline)}` : '' %>.</li>
        <li class="howto-note"><strong>Not sure how to fill one in?</strong> Each review has a step-by-step guide right at the top: "How this review works".</li>
        <% if (g.confirmer) { %>
          <li>When you submit, <strong><%= g.confirmer %></strong> checks it and confirms it. Then it's complete.</li>
        <% } else { %>
          <li>When you submit, the review is complete.</li>
        <% } %>
        <% if (g.confirmsFor.length) { %>
          <li>When <strong><%= list(g.confirmsFor) %></strong> submit<%= g.confirmsFor.length === 1 ? 's' : '' %> a review for their team, you check it, adjust it if needed, and confirm it.</li>
        <% } %>
        <li>HR and the CEO can also edit reviews. Every change shows under "Discussion and changes" on the review.</li>
      </ul>
    </div>
  <% } %>

  <%
    // Reviews written by this person's managers and waiting for them to confirm, found anywhere in the branch.
    const waiting = [];
    const walk = (nodes) => nodes.forEach((n) => {
      if (n.review && n.review.status === 'submitted' && n.review.confirmerId === user.id) waiting.push(n);
      walk(n.children || []);
    });
    if (isOpen) walk(g.roots);
  %>
  <section class="team-section team-write">
    <span class="team-tag">To write<%= isOpen && toWrite ? ` · ${toWrite} left` : '' %></span>
    <div class="card org-tree">
      <% g.roots.forEach(node => { %>
        <%- include('partials/org-node', { node, mode: 'team', cycleOpen: isOpen, isHrUser: false, STATUS_LABELS, csrfToken, user }) %>
      <% }) %>
    </div>
  </section>
  <% if (waiting.length) { %>
    <section class="team-section team-confirm">
      <span class="team-tag">To confirm · <%= waiting.length %></span>
      <div class="card org-tree">
        <% waiting.forEach(node => { %>
          <%- include('partials/org-node', { node: { ...node, direct: 0, children: [] }, mode: 'team', cycleOpen: isOpen, isHrUser: false, STATUS_LABELS, csrfToken, user, showWriter: true }) %>
        <% }) %>
      </div>
    </section>
  <% } %>
<% }) %>

<% if (earlier.length) { %>
  <h2>Earlier reviews of your team</h2>
  <p class="muted small">Reviews written by their previous managers. You can read them but not change them.</p>
  <div class="card">
    <ul>
      <% earlier.forEach(e => { %><li><a href="/reviews/<%= e.id %>"><%= e.employee_name %> · <%= e.cycle_name %></a></li><% }) %>
    </ul>
  </div>
<% } %>
<%- include('partials/footer') %>
