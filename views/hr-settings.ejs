<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Access settings</h1><p class="muted">People who see every review. Managers, department heads and employees get their access from each cycle's employee list.</p></div>
  <a class="btn" href="/hr">Back to HR</a>
</div>
<div class="card table-wrap" style="padding:0">
  <table>
    <thead><tr><th>Person</th><th>Access</th><th></th></tr></thead>
    <tbody>
      <% people.forEach(p => { %>
        <tr>
          <td><strong><%= p.name %></strong><br><span class="muted small"><%= p.email %></span></td>
          <td><%= p.global_role === 'hr_admin' ? 'HR admin: sees and edits all reviews' : 'Sees all reviews, read-only' %></td>
          <td>
            <% if (p.email !== user.email) { %>
              <form method="post" action="/hr/settings/role">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="email" value="<%= p.email %>">
                <input type="hidden" name="role" value="">
                <button class="btn small danger" type="submit">Remove access</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="card">
  <h3>Give someone access</h3>
  <p class="small muted">At most two HR admins (HR manager and one backup).</p>
  <form method="post" action="/hr/settings/role" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label>Name</label><input type="text" name="name"></div>
    <div class="field"><label>Work email</label><input type="email" name="email" required></div>
    <div class="field"><label>Access</label>
      <select name="role"><option value="viewer_all">Sees all reviews, read-only</option><option value="hr_admin">HR admin</option></select>
    </div>
    <button class="btn primary" type="submit">Save</button>
  </form>
</div>
<%- include('partials/footer') %>
