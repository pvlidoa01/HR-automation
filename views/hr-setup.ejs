<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1><%= cycle.name %> <span class="badge cycle-setup">Being set up</span></h1>
    <p class="muted"><% if (cycle.deadline) { %>Deadline <%= fmtDate(cycle.deadline) %> · <% } %>Nobody else can see this cycle until you initiate it.</p>
  </div>
  <a class="btn" href="/hr">Back to HR admin</a>
</div>

<div class="card" id="skills">
  <h3>1. Sync the skills with Notion</h3>
  <p class="small"><strong>Notion is the source of truth for skills.</strong> Every skill and its questionnaire is written in the Notion Skill Base, never in this app. To add a skill or change a questionnaire, do it <strong>in Notion first</strong>, then come back here and sync. Anything not in Notion does not reach this cycle.</p>
  <% if (notionReady) { %>
    <div class="btn-row" style="align-items:center">
      <a class="btn primary" href="/hr/skills/notion?cycle=<%= cycle.id %>">Sync skills with Notion</a>
      <a class="btn" href="https://www.notion.so/<%= skillBaseId %>" target="_blank" rel="noopener">Open the Skill Base in Notion</a>
    </div>
    <p class="small muted" style="margin-top:8px">Syncing shows every change first and applies nothing until you press Apply. The app has <%= skillCount %> skills now.</p>
    <% if (skillsSynced) { %>
      <div class="notice info small" style="margin-top:8px"><strong>Skills are synced</strong> with Notion (<%= fmtDateTime(lastSync.at) %>, <%= lastSync.by %>). If anyone edits Notion later, sync again before you initiate.</div>
    <% } else { %>
      <div class="notice warn small" style="margin-top:8px"><strong>Sync before you continue.</strong> The Excel template can be downloaded once the skills are synced for this cycle. This keeps the template's skill list and the questionnaires up to date.</div>
    <% } %>
  <% } else { %>
    <div class="notice warn small"><strong>The app is not connected to Notion yet</strong>, so it uses its own copy of the <%= skillCount %> skills. A Notion admin needs to connect it (steps in <em>docs/notion-skills.md</em>) before skills can be synced. Until then ask Alessandro to update skills.</div>
  <% } %>
</div>

<div class="card">
  <h3>2. Fill in the employee list</h3>
  <p class="small">Download the template and fill in one row per person reviewed, with their manager. The manager writes the review and the manager's own manager confirms it; the reporting lines also build the organisation tree. Heads who are not reviewed don't need a row. Skills come from the dropdown (the skills of the Notion Skill Base, each with its own behaviour checklist). A skill name that is not in the list is added automatically, without a checklist: managers then rate it 1–5 directly.</p>
  <% if (skillsSynced) { %>
    <a class="btn" href="/hr/template.xlsx">Download Excel template</a>
  <% } else { %>
    <button class="btn" type="button" disabled title="Sync the skills with Notion first (step 1)">Download Excel template</button>
    <span class="small muted">Available after step 1.</span>
  <% } %>
</div>

<div class="card">
  <h3>3. Upload it</h3>
  <p class="small muted">Uploading again replaces the whole list. Nothing is saved if the file has problems.</p>
  <form method="post" action="/hr/cycles/<%= cycle.id %>/roster" enctype="multipart/form-data" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><input type="file" name="file" accept=".xlsx" required></div>
    <button class="btn primary" type="submit">Upload and check</button>
  </form>
  <% if (cycle.roster_file) { %><p class="small muted" style="margin-top:8px">Last saved file: <%= cycle.roster_file %></p><% } %>
</div>

<% if (preview) { %>
  <div class="card">
    <h3>Problems in <%= preview.fileName %></h3>
    <% if (preview.fileErrors.length) { %>
      <div class="notice error"><ul><% preview.fileErrors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } else { %>
      <div class="notice error">
        <strong><%= preview.errorCount %> problem(s) found. Nothing was saved.</strong> Fix them in Excel and upload again.
        <% if (preview.structureErrors.length) { %><ul><% preview.structureErrors.forEach(e => { %><li><%= e %></li><% }) %></ul><% } %>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Row</th><th>Employee</th><th>Department / position</th><th>Seniority</th><th>Manager</th><th>Skills</th><th>Problems</th></tr></thead>
          <tbody>
            <% preview.rows.forEach(r => { %>
              <tr class="<%= r.errors.length ? 'has-error' : '' %>">
                <td><%= r.rowNumber %></td>
                <td><%= r.employeeName %><br><span class="muted small"><%= r.employeeEmail %></span></td>
                <td><%= r.department %><br><span class="muted small"><%= r.position %></span></td>
                <td><%= r.seniority %></td>
                <td><%= r.reviewerName %><br><span class="muted small"><%= r.reviewerEmail %></span></td>
                <td class="small"><%= r.skills.filter(Boolean).join(' · ') %></td>
                <td><% r.errors.forEach(e => { %><span class="err"><%= e %></span><% }) %><% r.warnings.forEach(w => { %><span class="warn"><%= w %></span><% }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } %>

<% if (locals.setupWarnings && setupWarnings.length) { %>
  <div class="notice warn"><strong>Please check:</strong><ul><% setupWarnings.forEach(w => { %><li><%= w %></li><% }) %></ul></div>
<% } %>

<div class="card">
  <h3>4. Check the saved list</h3>
  <% if (!saved.length) { %>
    <p class="muted">No list saved yet.</p>
  <% } else { %>
    <p class="small"><%= saved.length %> people, <%= new Set(saved.map(r => r.reviewer_email)).size %> managers, <%= departments.length %> departments.</p>
    <h3 style="margin-top:12px">Organisation</h3>
    <p class="small muted">Check the reporting lines: the top level should be the heads. Open a person to see their direct reports.</p>
    <div class="org-tree">
      <% roots.forEach(node => { %>
        <%- include('partials/org-node', { node, mode: 'hr', cycleOpen: false, isHrUser: true, STATUS_LABELS, csrfToken, user, noOpen: true }) %>
      <% }) %>
    </div>
    <h3 style="margin-top:16px">Full list</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Employee</th><th>Department / position</th><th>Seniority</th><th>Manager</th><th>Skill 1 · 2 · 3</th></tr></thead>
        <tbody>
          <% saved.forEach(r => { %>
            <tr>
              <td><%= r.employee_name %><br><span class="muted small"><%= r.employee_email %></span></td>
              <td><%= r.department %><br><span class="muted small"><%= r.position %></span></td>
              <td><%= r.seniority %></td>
              <td><%= r.reviewer_name %><br><span class="muted small"><%= r.reviewer_email %></span></td>
              <td class="small"><%= r.skills.join(' · ') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h3>5. Initiate the review cycle</h3>
  <p class="small">Each manager gets a review space with only their own reports, and (if turned on under HR → Emails) an email with their list and the deadline.</p>
  <div class="btn-row">
    <form method="post" action="/hr/cycles/<%= cycle.id %>/initiate">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn primary" type="submit" <%= saved.length ? '' : 'disabled' %>>Initiate review cycle</button>
    </form>
    <details>
      <summary class="small muted">Delete this cycle</summary>
      <form method="post" action="/hr/cycles/<%= cycle.id %>/delete" style="margin-top:6px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn small danger" type="submit">Yes, delete <%= cycle.name %></button>
      </form>
    </details>
  </div>
</div>
<%- include('partials/footer') %>
