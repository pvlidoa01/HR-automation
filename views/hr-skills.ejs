<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Skills</h1><p class="muted">The list HR picks three skills from for each person. Skills from the Notion Skill Base come with behaviour statements, so managers get the checklist; others are rated 1–5 directly.</p></div>
  <a class="btn" href="/hr">Back to HR</a>
</div>
<div class="card">
  <h3>Add a skill</h3>
  <form method="post" action="/hr/skills" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field" style="min-width:240px"><label for="sname">Name</label><input id="sname" type="text" name="name" required></div>
    <div class="field" style="flex:1;min-width:260px"><label for="sdef">Short definition (optional)</label><input id="sdef" type="text" name="definition"></div>
    <button class="btn primary" type="submit">Add</button>
  </form>
</div>
<div class="card table-wrap" style="padding:0">
  <table>
    <thead><tr><th>Skill</th><th>Source</th><th>Checklist</th><th>Used in reviews</th></tr></thead>
    <tbody>
      <% skills.forEach(s => { const n = Object.values(s.levels || {}).reduce((a, l) => a + l.length, 0); %>
        <tr>
          <td><strong><%= s.name %></strong><% if (s.draft) { %> <span class="badge status-not_started">Draft in Notion</span><% } %>
            <% if (s.definition) { %><br><span class="muted small"><%= s.definition %></span><% } %></td>
          <td><%= { notion: 'Notion Skill Base', hr: 'Added by HR', import: 'Imported' }[s.source] %></td>
          <td><%= n ? `${n} statements` : '—' %></td>
          <td><%= s.used %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
