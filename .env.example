# Copy the values into Replit → Secrets (never commit real values).

# Added automatically when you create a PostgreSQL database in Replit.
DATABASE_URL=

# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first HR admin (Daria). She can add one backup HR admin and the CEO in Access settings.
INITIAL_HR_ADMIN_EMAIL=
INITIAL_HR_ADMIN_NAME=

# Public address of the app, e.g. https://r3-performance-review.replit.app
APP_BASE_URL=

# Test login: anyone can sign in as anyone. Only while testing with fake data.
ALLOW_TEST_LOGIN=false
# Also needed to use test login on a deployment (fake data only):
# ALLOW_TEST_LOGIN_ON_DEPLOYMENT=true

# Microsoft sign-in (from IT, see docs/microsoft-sign-in-request.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: only these email domains can sign in
MS_ALLOWED_EMAIL_DOMAINS=r3robotics.ai
